# Copy this file to .env and fill in real values. Never commit .env itself.

# Random long string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-string

# Shared password committee members use to log in
COMMITTEE_PASSWORD=replace-with-a-real-password

# Separate password for the Gear Secretary's gear register (serials, inspections)
GEAR_PASSWORD=replace-with-another-real-password

# Optional: only needed if you switch off SQLite (e.g. to Postgres on a host)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional, local development only. Set to 1 to allow SECRET_KEY/
# COMMITTEE_PASSWORD to fall back to insecure defaults if unset, and to relax
# the session cookie's Secure flag for plain http://127.0.0.1 use. Leave
# unset (or 0) everywhere else - `flask run --debug` also has the same
# effect for a single local run without setting this.
# FLASK_DEBUG=1
